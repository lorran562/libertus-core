[Unit]
Description=LIBERTUS v10.0 - Agente Autônomo de Cybersecurity
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/LIBERTUS
EnvironmentFile=%h/LIBERTUS/.env
ExecStart=/usr/bin/python3 %h/LIBERTUS/core/libertus_daemon_v2_real.py
Restart=on-failure
RestartSec=10
StandardOutput=append:%h/LIBERTUS/logs/daemon.log
StandardError=append:%h/LIBERTUS/logs/daemon.log

[Install]
WantedBy=default.target
