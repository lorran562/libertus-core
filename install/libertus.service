User=%i
WorkingDirectory=/home/%i/LIBERTUS
Environment="GROQ_API_KEY=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"
ExecStart=/usr/bin/python3 /home/%i/LIBERTUS/core/libertus_daemon_v2_real.py
